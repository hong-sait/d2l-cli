{
  "manifest_version": 3,
  "name": "Brightspace Read-only CLI Bridge",
  "version": "0.2.0",
  "description": "Read-only Brightspace API checks and CLI bridge for approved routes.",
  "permissions": ["activeTab", "nativeMessaging"],
  "host_permissions": ["https://learn.sait.ca/*"],
  "action": { "default_title": "Brightspace M1 checks", "default_popup": "popup.html" },
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["https://learn.sait.ca/*"],
    "js": ["core.js", "content.js"],
    "run_at": "document_idle"
  }]
}
