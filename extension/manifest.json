{
  "manifest_version": 3,
  "name": "Brightspace Student Search",
  "version": "0.3.0",
  "description": "Search current-term Brightspace classlists and connect the read-only CLI bridge.",
  "permissions": ["activeTab", "nativeMessaging"],
  "host_permissions": ["https://learn.sait.ca/*"],
  "icons": {
    "16": "d2l-favicon.png",
    "32": "d2l-favicon.png",
    "48": "d2l-favicon.png",
    "128": "d2l-favicon.png"
  },
  "action": { "default_title": "Brightspace Student Search", "default_popup": "popup.html", "default_icon": "d2l-favicon.png" },
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["https://learn.sait.ca/*"],
    "js": ["core.js", "content.js"],
    "run_at": "document_idle"
  }]
}
